# Copy to .env. Keep credentials out of git and browser/VITE_ variables.
# Thor is hosted; these URLs are not localhost. Replace <project-slug> with the slug
# from accounts.thorcommerce.io after creating your store. Or create one with:
# mkdir -p ~/ThorStores
# npx --yes create-thor-store@latest --workspace ~/ThorStores
# Complete the onboarding link and keep the runner open. Its completion prompt
# provides the project slug and Storefront credentials/context.
THOR_STOREFRONT_URL=https://api.thorcommerce.io/<project-slug>/storefront/graphql
THOR_ADMIN_URL=https://api.thorcommerce.io/<project-slug>/admin/graphql
# Protected Storefront token, sent as x-thor-storefront-token. Empty for anonymous stores.
THOR_ACCESS_TOKEN=
# Separate Admin key, sent as X-Api-Key only on the server.
THOR_ADMIN_API_KEY=
# Thor store ID and price-channel ID (opaque IDs from your store configuration).
THOR_STORE_ID=
THOR_CHANNEL=
# Two-letter country and three-letter currency, e.g. NL and EUR.
THOR_MARKET=
THOR_CURRENCY=
# Optional supported markets JSON, including the THOR_MARKET default ID.
# [{"id":"NL","label":"Netherlands","channel":"channel_...","country":"NL","currency":"EUR"}, ...]
THOR_MARKETS=
# Optional agency buyer location label plus its Thor buyer price-channel mapping.
# Thor's public schema has no native company-location or quantity-rule argument.
THOR_COMPANY_LOCATION_ID=
THOR_COMPANY_PRICE_CHANNEL_ID=
# Optional Better Auth plugin sign-in: secret at least 32 random characters.
# This example keeps sessions in BFF memory; restart requires sign-in again.
THOR_AUTH_SECRET=
# Match your generated Traefik public origins (include a non-default host port).
THOR_FRONTEND_ORIGIN=http://app.tdk-thor-storefront.localhost:8080
THOR_BFF_ORIGIN=http://api.tdk-thor-storefront.localhost:8080
# Optional browser-safe override; default derives api host and port from app origin.
VITE_THOR_BFF_URL=
# Host proxy ports only; resource ports are not published on localhost.
TDK_HTTP_PORT=8080
TDK_HTTPS_PORT=8443
